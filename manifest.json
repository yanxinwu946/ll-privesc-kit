{
  "$schema": "https://raw.githubusercontent.com/ll-privesc-kit/ll-privesc-kit/main/manifest.schema.json",
  "name": "ll-privesc-kit",
  "description": "Linux 本地提权漏洞 PoC 合集（按漏洞时间排序，官方源码 + gnu/musl 静态 CI 产物）",
  "license": "MIT",
  "repo": "https://github.com/yanxinwu946/ll-privesc-kit",
  "build": {
    "contract": "NNname/build.sh <outdir> [gnu|musl]",
    "orchestrator": "./build/build.sh [gnu|musl] [outdir]",
    "ci": ".github/workflows/build.yml",
    "variants": ["gnu", "musl"]
  },
  "exploits": [
    {
      "id": "01dirtycow",
      "cve": "CVE-2016-5195",
      "name": "Dirty COW",
      "type": "kernel race",
      "published": "2016-10",
      "kernel_range": "2.6.22 ~ 4.8.3",
      "build": "c",
      "upstream": "https://github.com/dirtycow/dirtycow.github.io"
    },
    {
      "id": "02sudo-samedit",
